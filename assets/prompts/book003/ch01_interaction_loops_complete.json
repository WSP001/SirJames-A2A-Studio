{
  "chapter_id": "ch01_whispering_woods",
  "book": "book003",
  "theme": "Baseline Safety & Listening",
  "skill_focus": "survival_baseline",
  "virtue_focus": ["courage", "wisdom"],
  "voice_ids": {
    "sir_james": "SOYHLrjzK2X1ezoPC6cr",
    "narrator": "XrExE9yKIg1WjnnlVkGX",
