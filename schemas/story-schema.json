{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sirjamesadventures.com/schemas/story-schema-v3.0.json",
  "title": "Sir James Adventures Interactive Story Schema",
  "description": "JSON Schema v3.0 for Sir James Adventures interactive story format",
  "type": "object",
  "required": ["version", "metadata", "characters", "scenes"],
  "properties": {
    "version": {
      "type": "string",
      "const": "3.0",
      "description": "Schema version constant"
    },
    "metadata": {
      "type": "object",
      "required": ["title", "book", "chapter", "author", "created", "updated"],
      "properties": {
        "title": {
          "type": "string",
          "description": "Story title"
        },
        "book": {
          "type": "string",
          "pattern": "^Book\\d{3}$",
          "description": "Book identifier (e.g., Book003)"
        },
        "chapter": {
          "type": "string",
          "pattern": "^Chapter\\d{2}$",
          "description": "Chapter identifier (e.g., Chapter01)"
        },
        "author": {
          "type": "string",
          "description": "Story author"
        },
        "created": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updated": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        },
        "description": {
          "type": "string",
          "description": "Story description"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Story tags"
        }
      }
    },
    "characters": {
      "type": "object",
      "required": ["sir_james", "sparky"],
      "properties": {
        "sir_james": {
          "type": "object",
          "required": ["name", "description", "traits"],
          "properties": {
            "name": {
              "type": "string",
              "const": "Sir James",
              "description": "Character name"
            },
            "description": {
              "type": "string",
              "description": "Character description"
            },
            "traits": {
              "type": "object",
              "required": ["eye_color"],
              "properties": {
                "eye_color": {
                  "type": "string",
                  "const": "blue",
                  "description": "Sir James has blue eyes"
                },
                "personality": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Character personality traits"
                }
              }
            }
          }
        },
        "sparky": {
          "type": "object",
          "required": ["name", "species", "description"],
          "properties": {
            "name": {
              "type": "string",
              "const": "Sparky",
              "description": "Character name"
            },
            "species": {
              "type": "string",
              "const": "squirrel",
              "description": "Sparky is a squirrel"
            },
            "description": {
              "type": "string",
              "description": "Character description"
            },
            "traits": {
              "type": "object",
              "properties": {
                "personality": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Character personality traits"
                }
              }
            }
          }
        }
      },
      "additionalProperties": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "species": {
            "type": "string"
          },
          "traits": {
            "type": "object"
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "scene_type", "title", "content"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ch\\d{2}_s\\d{3}$",
            "description": "Scene ID in format ch##_s### (e.g., ch01_s001)"
          },
          "scene_type": {
            "type": "string",
            "enum": ["narrative", "decision", "climax", "introduction", "conclusion"],
            "description": "Type of scene"
          },
          "title": {
            "type": "string",
            "description": "Scene title"
          },
          "content": {
            "type": "string",
            "description": "Scene content/text"
          },
          "characters": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Characters present in this scene"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "text", "virtue"],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Choice identifier"
                },
                "text": {
                  "type": "string",
                  "description": "Choice text displayed to user"
                },
                "virtue": {
                  "type": "string",
                  "enum": ["courage", "wisdom", "trust"],
                  "description": "Virtue associated with this choice"
                },
                "next_scene": {
                  "type": "string",
                  "pattern": "^ch\\d{2}_s\\d{3}$",
                  "description": "ID of the next scene if this choice is selected"
                },
                "consequence": {
                  "type": "string",
                  "description": "Consequence or outcome of this choice"
                }
              }
            },
            "description": "Interactive choices for decision scenes"
          },
          "next_scene": {
            "type": "string",
            "pattern": "^ch\\d{2}_s\\d{3}$",
            "description": "Default next scene ID for non-decision scenes"
          }
        }
      }
    }
  }
}